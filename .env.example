# paper-compass environment variables
# Copy to .env and fill in your values
#   cp .env.example .env

# ── LLM (wiki generation) ───────────────────────────────────────────────
# Base URL for the LLM API
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# Your LLM API key
LLM_API_KEY=your_key_here

# ── Volcengine Embedding ─────────────────────────────────────────────────
# Base URL for the Volcengine multimodal embedding endpoint
VOLC_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# Your Volcengine API key
VOLC_EMBED_API_KEY=your_key_here
# Your Volcengine embedding model endpoint ID (e.g. ep-20260420154519-xxxxx)
VOLC_EMBED_MODEL=your_endpoint_id

# ── PaperQA (optional — for full PDF RAG) ───────────────────────────────
# PAPERQA_BASE_URL=
# PAPERQA_API_KEY=
# PAPERQA_MODEL=
