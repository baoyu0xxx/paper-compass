# paper-compass environment variables
# Copy to .env and fill in your values
#   cp .env.example .env
#
# Alternatively, run `paper-compass init` for interactive setup.
#
# API keys support $ENV_VAR syntax: instead of storing a literal key,
# you can reference an environment variable that is already set:
#   LLM_API_KEY=$OPENAI_API_KEY    # resolves os.environ["OPENAI_API_KEY"]
#   LLM_API_KEY=$MY_CUSTOM_KEY     # resolves os.environ["MY_CUSTOM_KEY"]
#
# If the referenced env var is not set, the $VAR name is used literally.

# ── LLM (wiki generation) ───────────────────────────────────────────────
# Base URL for the LLM API (OpenAI-compatible chat/completions endpoint)
LLM_BASE_URL=https://api.openai.com/v1
# Your LLM API key, or $ENV_VAR reference
LLM_API_KEY=your_key_here
# Model name (e.g. "gpt-4o", "mimo-v2.5-pro", "claude-sonnet-4")
# LLM_MODEL=gpt-4o

# ── Embedding (default: standard OpenAI-compatible) ─────────────────────
# Base URL for the embedding API
EMBED_BASE_URL=https://api.openai.com/v1
# Your embedding API key, or $ENV_VAR reference
EMBED_API_KEY=your_key_here
# Model name (optional — overrides providers.yaml default)
# EMBED_MODEL=text-embedding-3-small

# ── Volcengine multimodal embedding (alternative provider) ──────────────
# Uncomment and fill these to use Volcengine instead of OpenAI embed:
# VOLC_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# VOLC_EMBED_API_KEY=$VOLC_API_KEY
# VOLC_EMBED_MODEL=ep-20260420154519-9w64q

# ── PaperQA (optional — for full PDF RAG) ───────────────────────────────
# PAPERQA_BASE_URL=
# PAPERQA_API_KEY=
# PAPERQA_MODEL=
