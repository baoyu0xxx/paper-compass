# paper-compass configuration example
# API keys support $ENV_VAR syntax, e.g. LLM_API_KEY=$OPENAI_API_KEY

# ── LLM (wiki generation) ──────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=$OPENAI_API_KEY
LLM_MODEL=gpt-4o

# ── Embedding (Alibaba Cloud Bailian / Qwen, default) ───────────
# Select exactly one cloud provider: aliyun or volcengine.
EMBED_PROVIDER=aliyun
# EMBED_BASE_URL=https://<dashscope-compatible-endpoint>/v1/embeddings
# EMBED_API_KEY=$DASHSCOPE_API_KEY
# EMBED_MODEL=qwen3.7-text-embedding-flash

# ── Embedding (Volcengine alternative) ──────────────────────────
# Set EMBED_PROVIDER=volcengine to select this provider.
# VOLC_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# VOLC_EMBED_API_KEY=$VOLC_API_KEY
# VOLC_EMBED_MODEL=doubao-embedding-vision-250615

# ── Embedding (local fallback) ─────────────────────────────────
# Used only when EMBED_* and VOLC_EMBED_* are both unset.
# Supported: bge-base, specter, minilm
# LOCAL_EMBED_MODEL=bge-base

# ── Optional Zotero paths ──────────────────────────────────────
# If unset, sync resolves: explicit CLI args > env path > default Zotero dirs > backup roots.
# Zotero SQLite is opened read-only; live default profiles are read through runtime snapshots by default.
# ZOTERO_SQLITE_PATH=/path/to/zotero.sqlite
# ZOTERO_STORAGE_PATH=/path/to/storage

# ── Optional Zotero backup root ────────────────────────────────
# Used only after explicit path / env path / default Zotero dirs fail.
# ZOTERO_BACKUP_ROOT=/path/to/zotero_backup

# ── Wiki prompt preset ─────────────────────────────────────────
# WIKI_PROMPT=default
# WIKI_PROMPT=economics
