# paper-compass configuration example
# API keys support $ENV_VAR syntax, e.g. LLM_API_KEY=$OPENAI_API_KEY

# ── LLM (wiki generation) ──────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=$OPENAI_API_KEY
LLM_MODEL=gpt-4o

# ── Embedding (OpenAI-compatible) ──────────────────────────────
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=$OPENAI_API_KEY
# EMBED_MODEL=text-embedding-3-small

# ── Embedding (Volcengine fallback) ────────────────────────────
# VOLC_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# VOLC_EMBED_API_KEY=$VOLC_API_KEY
# VOLC_EMBED_MODEL=doubao-embedding-vision-250615

# ── Embedding (local fallback) ─────────────────────────────────
# Used only when EMBED_* and VOLC_EMBED_* are both unset.
# Supported: bge-base, specter, minilm
# LOCAL_EMBED_MODEL=bge-base

# ── Optional Zotero backup root ────────────────────────────────
# Used only after explicit path / env path / default Zotero dirs fail.
# ZOTERO_BACKUP_ROOT=/path/to/zotero_backup

# ── Wiki prompt preset ─────────────────────────────────────────
# WIKI_PROMPT=default
# WIKI_PROMPT=economics
