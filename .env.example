# paper-compass environment variables
# Copy to .env and fill in your values
#   cp .env.example .env

# ── LLM (wiki generation) ───────────────────────────────────────────────
# Base URL for the LLM API (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
# Your LLM API key
LLM_API_KEY=your_key_here

# ── Embedding (default: standard OpenAI-compatible) ─────────────────────
# Base URL for the embedding API
EMBED_BASE_URL=https://api.openai.com/v1
# Your embedding API key
EMBED_API_KEY=your_key_here
# Model name (optional — overrides providers.yaml default)
# EMBED_MODEL=text-embedding-3-small

# ── Volcengine multimodal embedding (alternative provider) ──────────────
# Uncomment and fill these to use Volcengine instead of OpenAI embed:
# VOLC_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# VOLC_EMBED_API_KEY=your_key_here
# VOLC_EMBED_MODEL=your_endpoint_id

# ── PaperQA (optional — for full PDF RAG) ───────────────────────────────
# PAPERQA_BASE_URL=
# PAPERQA_API_KEY=
# PAPERQA_MODEL=
